PORT=5478
NODE_ENV=production

# SQL Server connection (use either this or the DB_* block below)
# SQLCMD=Server=localhost,1433;Database=hm_sms;User Id=hm_user;Password=CHANGE_ME;Encrypt=false;TrustServerCertificate=true

DB_HOST=localhost
DB_PORT=1433
DB_USER=hm_user
DB_PASSWORD=CHANGE_ME
DB_DATABASE=hm_sms
DB_ENCRYPT=false

JWT_SECRET=CHANGE_ME_LONG_RANDOM_STRING
JWT_EXPIRES_IN=7d
ADMIN_EMAIL=admin@hmsms.local
ADMIN_PASSWORD=Admin@12345
ADMIN_NAME=System Administrator
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10
CORS_ORIGIN=*